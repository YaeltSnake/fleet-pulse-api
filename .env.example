# fleet-pulse-api — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env — only .env.example goes to version control

# Database
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/fleet_pulse
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=generate_with_openssl_rand_base64_32
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# QSolutions SOAP
QSOLUTIONS_USERNAME=your_username
QSOLUTIONS_PASSWORD=your_password
QSOLUTIONS_PROVEEDOR=Digi-Haul
QSOLUTIONS_TRACKING_NUMBER=1

# GPS
GPS_MAX_COORDINATE_AGE_SECONDS=300

# Admin Bootstrap (used only on first startup when no ADMIN exists)
INITIAL_ADMIN_USERNAME=your_admin_username
INITIAL_ADMIN_PASSWORD=your_secure_password_min_16_chars

# CORS — allowed frontend origin (default: Vite dev server)
ALLOWED_ORIGIN=http://localhost:5173

# BCrypt cost factor — if you change this, you MUST regenerate AuthService.DUMMY_HASH
# at the same strength, or the app will fail fast on startup (see AuthService constructor guard)
BCRYPT_STRENGTH=10

# GPS ingestion rate limit — max accepted pushes per unit (numUnidad) per window.
# Protects against misconfigured Traccar Client (e.g. "highest" accuracy polling every ~1s).
RATE_LIMIT_GPS_MAX_PUSHES=1
RATE_LIMIT_GPS_WINDOW_SECONDS=10

# httpOnly refresh_token cookie — Secure flag. Keep true always; modern browsers treat
# http://localhost as a secure-context exception, so this works in local dev without HTTPS.
# Only set to false for exotic dev setups (LAN IP, non-localhost tunnel without TLS).
COOKIE_SECURE=true